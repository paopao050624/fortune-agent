include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md THIRD_PARTY_NOTICES.md
include Dockerfile compose.yaml package.json pnpm-lock.yaml pnpm-workspace.yaml .env.example .dockerignore
recursive-include src/fortune_agent/data *.json
recursive-include src/fortune_agent/static *.html *.cjs *.txt *.svg
recursive-include docs *.md
recursive-include scripts *.py *.cjs
recursive-include tests *.py
recursive-include evals *.json *.jsonl *.md
recursive-include .github *.yml *.md
prune work
prune node_modules
prune .pnpm-store
